# Copia este archivo a ".env" y ajusta los valores. NO subas el .env a git.

# ============================================================
#  PROVEEDOR PRIMARIO — Ollama Cloud (recomendado, como en prod)
#  Modelo gpt-oss:120b: modelo grande de OpenAI, GRATIS en Ollama Cloud.
#  1) Crea cuenta en https://ollama.com
#  2) Genera una API key en https://ollama.com/settings/keys
# ============================================================
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=pon-aqui-tu-api-key-de-ollama-cloud

# ============================================================
#  FAILOVER (opcional pero recomendado) — se usa si el primario
#  falla o se agota el free tier. Puede ser:
#    - el modelo mas liviano:  gpt-oss:20b  (misma cuenta)
#    - OTRA cuenta de Ollama Cloud
#    - un Ollama LOCAL de respaldo
#  Deja estas 3 vacias para NO usar failover.
# ============================================================
FAILOVER_BASE_URL=https://ollama.com/v1
FAILOVER_MODEL=gpt-oss:20b
FAILOVER_API_KEY=pon-aqui-otra-api-key-o-la-misma

# ============================================================
#  ALTERNATIVA 100% LOCAL (gratis, privado, sin nube)
#  Descomenta estas y comenta las de Ollama Cloud de arriba.
#  Requiere Ollama instalado + un modelo bajado (ollama pull llama3.2).
# ============================================================
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2
# OLLAMA_API_KEY=ollama

# --- Seguridad / red ---
# En produccion poné el dominio EXACTO de tu sitio (no uses * en vivo):
ALLOWED_ORIGIN=https://tudominio.com
PORT=8080
